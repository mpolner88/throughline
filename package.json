{
  "name": "throughline",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "description": "Throughline is where you speak notes for your AI agent.",
  "scripts": {
    "start": "node backend/stub-server.mjs",
    "eval:run": "node evals/run-extraction.mjs",
    "eval:run:groq": "node evals/run-extraction.mjs --provider command --command ./evals/adapters/groq-extract.mjs --delay-ms 2500",
    "eval:score": "node evals/score-extraction.mjs --predictions evals/runs/latest",
    "eval:score:action": "node evals/score-extraction.mjs --predictions evals/runs/latest --profile action",
    "eval:score:memory": "node evals/score-extraction.mjs --predictions evals/runs/latest --profile memory",
    "eval:import-feedback": "node evals/import-feedback-fixtures.mjs",
    "eval:plumbing": "node evals/run-extraction.mjs --out /private/tmp/throughline-eval-golden && node evals/score-extraction.mjs --predictions /private/tmp/throughline-eval-golden && node evals/run-private-audio.mjs --manifest evals/fixtures/synthetic/private-audio-manifest.json --adapter evals/fixtures/synthetic/local-adapter.mjs --out /private/tmp/throughline-eval-synthetic-bundle.json",
    "eval:quality": "node evals/score-private-audio.mjs --manifest evals/private/manifest.json --predictions evals/runs/private/latest --split sealed_holdout --min-accepted-full-output-cases 20",
    "eval:artifact-canary": "node scripts/verify-evaluation-artifact-canary.mjs",
    "eval:hosted-artifact-canary": "node scripts/verify-evaluation-edge-storage-canary.mjs",
    "eval:artifact-storage:test": "deno test --allow-env supabase/functions/private-artifact-delete",
    "privacy:check": "node scripts/check-privacy-policy-parity.mjs",
    "eval:rollout-package": "node scripts/build-evaluation-rollout-package.mjs",
    "eval:rollout-package:test": "node --test scripts/build-evaluation-rollout-package.test.mjs",
    "eval:owner-canary-package": "node scripts/build-evaluation-owner-canary-package.mjs",
    "eval:owner-canary-package:test": "node --test scripts/build-evaluation-owner-canary-package.test.mjs",
    "ios:app-icons": "node scripts/generate-ios-app-icons.mjs",
    "appstore:screenshots": "node scripts/generate-app-store-screenshots.mjs",
    "docs:verify": "node scripts/verify-repository-foundation.mjs",
    "product:weekly": "node --env-file=.env.local scripts/product-learning-report.mjs",
    "product:weekly:test": "node --test scripts/product-learning-report.test.mjs",
    "product:auth-canary": "node --env-file=.env.local scripts/auth-canary.mjs",
    "product:recording-canary": "node scripts/recording-canary.mjs",
    "product:dashboard": "node scripts/generate-product-dashboard.mjs",
    "extraction:test": "node --test core/extraction-pipeline.test.mjs",
    "ios:sync-config": "node scripts/sync-ios-config.mjs",
    "ios:build": "npm run ios:app-icons && npm run ios:sync-config && xcodebuild -project ios/Throughline.xcodeproj -scheme Throughline -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "ios:build:device": "npm run ios:app-icons && npm run ios:sync-config && xcodebuild -project ios/Throughline.xcodeproj -scheme Throughline -destination 'generic/platform=iOS' -derivedDataPath ios/build/DerivedDataDevice CODE_SIGNING_ALLOWED=NO build",
    "agent:smoke": "node backend/smoke-memory-tools.mjs",
    "note:edit:smoke": "node backend/smoke-note-edits.mjs",
    "mcp:stdio": "node backend/mcp-stdio-server.mjs",
    "mcp:smoke": "node backend/smoke-mcp-stdio.mjs",
    "mockup:dev": "node mockup/dev-server.mjs",
    "stub:dev": "node backend/stub-server.mjs",
    "stub:dev:extract": "THROUGHLINE_EXTRACTOR_COMMAND=./backend/dev-extractor.mjs node backend/stub-server.mjs",
    "stub:dev:supabase": "node --env-file=.env.local backend/stub-server.mjs",
    "supabase:deploy": "node scripts/deploy-supabase.mjs"
  }
}
