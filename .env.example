GROQ_API_KEY=

# Local backend
HOST=127.0.0.1
PORT=5180
THROUGHLINE_STORAGE=file
THROUGHLINE_STUB_DATA_DIR=backend/data
THROUGHLINE_TRANSCRIBER=
THROUGHLINE_EXTRACTOR_COMMAND=./backend/dev-extractor.mjs

# Supabase-backed local Node backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_AUDIO_BUCKET=throughline-audio
THROUGHLINE_USER_ID=dev-user
THROUGHLINE_API_TOKEN=
THROUGHLINE_MCP_TOKEN=

# Supabase Edge Functions use SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# automatically in production. Set GROQ_API_KEY, THROUGHLINE_API_TOKEN,
# THROUGHLINE_AUDIO_BUCKET, THROUGHLINE_USER_ID, and optionally
# THROUGHLINE_MCP_TOKEN with `supabase secrets set`.
THROUGHLINE_AUDIO_BUCKET=throughline-audio

# Live dogfood processing for the local Node backend
# THROUGHLINE_TRANSCRIBER=groq
# THROUGHLINE_EXTRACTOR_COMMAND=./evals/adapters/groq-extract.mjs
